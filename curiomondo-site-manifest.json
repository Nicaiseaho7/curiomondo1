{
  "schema_version": 2,
  "site": {
    "name": "CurioMondo",
    "base_url": "https://curiomondo.it/",
    "deployment": "GitHub main branch connected to Netlify automatic deployment",
    "current_protocol_version": "2.1",
    "protocol_introduced_in_site_version": 139,
    "protocol_date": "2026-09-06",
    "current_site_version": 300,
    "site_version": 300
  },
  "instruction_priority": [
    "latest_explicit_owner_instruction",
    "PROTOCOLLO-QUALITA-EDITORIALE-ADSENSE.md",
    "CURIO-MONDO-PROTOCOLLO-MAESTRO.md",
    "curiomondo-site-manifest.json",
    "current_site_implementation",
    "legacy_update_notes"
  ],
  "daily_state": {
    "last_question_date": "2026-09-07",
    "question_archive_path": "/domanda-del-giorno/",
    "question_library_root": "/biblioteca/vita-relazioni/",
    "on_any_update_if_current_date_is_newer": "CREATE_DAILY_QUESTION_BEFORE_RELEASE",
    "timezone": "Europe/Rome",
    "date_source": "current_datetime_in_Europe_Rome_never_UTC"
  },
  "homepage": {
    "hero_section_label": "Ultima ora",
    "hero_selection_mode": "editorial_importance_among_recent_eligible_articles",
    "featured_section_label": "Ultime notizie",
    "featured_exact_count": 5,
    "live_exact_count": 10,
    "live_order": "newest_first",
    "chronological_continuity": {
      "rule": "auto-rail (Ultime notizie) + #cards (Tutte le notizie) formano una sequenza continua, senza salti, ordinata per datePublished decrescente tra gli articoli idonei escluso quello eventualmente occupato dalla card featured/Ultima ora",
      "featured_exempt_from_strict_chronology": true,
      "featured_must_not_hide_article_from_other_required_surfaces": true,
      "ticker_exempt": true,
      "enforced_by": "tools/predeploy.py"
    }
  },
  "news": {
    "deduplicate": true,
    "update_requires_substantive_development": true,
    "if_update_but_origin_missing": "explain_origin_first_then_new_development",
    "war_claims_single_side_are_not_established_fact": true,
    "required_outputs": [
      "article_html",
      "seo_metadata",
      "canonical",
      "NewsArticle_JSON_LD",
      "editorial_image",
      "homepage_or_editorial_listing_update",
      "archive_update",
      "search_update",
      "internal_links",
      "feed_xml",
      "sitemap_xml",
      "news_sitemap_xml_if_eligible"
    ],
    "publication_complete_only_when_all_required_outputs_exist": true,
    "article_body_characters": {
      "mandatory_min": 3000,
      "mandatory_max": 7000,
      "count_scope": "visible_text_inside_.art-body_only",
      "exceptions_allowed": false,
      "if_insufficient_verified_information": "do_not_publish_standalone_article",
      "if_over_max": "rewrite_and_remove_secondary_or_redundant_material",
      "padding_for_length_forbidden": true,
      "semantic_repetition_forbidden": true,
      "each_paragraph_must_add_new_information": true,
      "closing_recap_that_repeats_body_forbidden": true
    },
    "knowledge_hook_required": true,
    "knowledge_hook_rule": "Add at least one useful non-obvious context element; this does not require defining difficult words.",
    "evergreen_deep_dive_rule": "create_or_link_only_when_the_concept_adds_durable_non_redundant_value; explain_in_body_when_that_is_sufficient",
    "minimum_reliable_sources": 3,
    "sources_preference": "when_possible_at_least_one_primary_or_official_and_one_independent",
    "source_independence_rule": "three_sources_repeating_the_same_wire_or_origin_do_not_automatically_count_as_three_independent_confirmations",
    "quote_and_sensitive_claim_source_required": true,
    "no_low_value_rewrites_of_external_sources": true,
    "automatic_difficult_word_explanations": false,
    "terminology_rule": "use_clear_natural_italian; clarify_only_when_omission_would_impair_understanding_accuracy_or_safety; no_glossary_effect"
  },
  "images": {
    "new_editorial_images_must_be_ai_generated": true,
    "public_figure_synthetic_likeness_policy": {
      "allowed": true,
      "policy_mode": "context_sensitive",
      "ordinary_news": {
        "contextual_scenes_allowed": true,
        "relevant_logos_allowed": true
      },
      "sensitive_news": {
        "neutral_isolated_portrait_required": true
      },
      "must_never_be_presented_as_documentary_evidence": true
    },
    "new_image_required_for_each_new_article_or_substantive_update": true,
    "generation_blocking": true,
    "article_complete_only_after_image_generated_registered_and_attached": true,
    "hero_og_newsarticle_must_match": true,
    "must_disclose_ai_generation": true,
    "canonical_policy_file": "AI-EDITORIAL-IMAGE-PROTOCOL.md",
    "generator_contract_file": "automation/prompts/image-generation-contract.txt",
    "mobile_and_hero_crop_check_required": true,
    "retry_on_failure": true,
    "real_public_figures_allowed": true,
    "real_brands_logos_and_places_allowed_when_editorially_relevant": true,
    "no_false_sponsorship_or_documentary_claim": true
  },
  "deep_dives": {
    "separate_from_news_article": true,
    "create_when_useful": true,
    "must_add_new_value": true,
    "forced_creation_for_simple_terms_forbidden": true,
    "link_existing_equivalent_instead_of_duplicate": true,
    "internal_linking_required": true
  },
  "seo": {
    "sitemap": "/sitemap.xml",
    "news_sitemap": "/news-sitemap.xml",
    "feed": "/feed.xml",
    "orphan_pages_forbidden": true
  },
  "performance": {
    "lighthouse_pagespeed_target": {
      "min": 90,
      "max": 100
    },
    "priority": "mobile",
    "quality_must_not_be_sacrificed_for_image_optimization": true
  },
  "predeploy": {
    "required": true,
    "must_exit_zero": true,
    "publication_blocked_on_error": true
  },
  "post_deploy": {
    "required": true,
    "checks": [
      "article_http_200",
      "hero_image_http_200",
      "canonical_matches_public_url",
      "expected_editorial_listing_contains_article",
      "archive_contains_article",
      "feed_contains_article_if_eligible",
      "sitemap_contains_article",
      "news_sitemap_contains_article_if_eligible"
    ],
    "commit_success_is_not_equal_to_verified_publication": true
  }
}
